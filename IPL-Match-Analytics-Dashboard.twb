      <aliases enabled='yes' />
      <column caption='Team Name Clean' datatype='string' name='[Calculation_0719650617008128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [batting_team] = &quot;Delhi Daredevils&quot; THEN &quot;Delhi Capitals&quot;&#13;&#10;ELSEIF [batting_team] = &quot;Kings XI Punjab&quot; THEN &quot;Punjab Kings&quot;&#13;&#10;ELSE&#13;&#10;    [batting_team]&#13;&#10;END' />
      </column>
      <column caption='Bowling Team Clean' datatype='string' name='[Calculation_0719650619256834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bowling_team] = &quot;Delhi Daredevils&quot; THEN &quot;Delhi Capitals&quot; &#13;&#10;ELSEIF [bowling_team] = &quot;Kings XI Punjab&quot; THEN &quot;Punjab Kings&quot; &#13;&#10;ELSE&#13;&#10;[bowling_team] &#13;&#10;END' />
      </column>
      <column caption='Bowler Wickets' datatype='integer' name='[Calculation_0759510688075776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [wicket_kind] != &quot;run out&quot;&#13;&#10;AND [wicket_kind] != &quot;retired hurt&quot;&#13;&#10;AND [wicket_kind] != &quot;obstructing the field&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Toss Winner Clean' datatype='string' name='[Calculation_0759510729191425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [toss_winner] = &quot;Delhi Daredevils&quot; THEN &quot;Delhi Capitals&quot;&#13;&#10;ELSEIF [toss_winner] = &quot;Kings XI Punjab&quot; THEN &quot;Punjab Kings&quot;&#13;&#10;ELSE&#13;&#10;    [toss_winner]&#13;&#10;END' />
      </column>
      <column caption='Total fours' datatype='integer' name='[Calculation_0759510738087942]' role='measure' type='quantitative'>
